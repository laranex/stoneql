+fn check_packet_size(received: usize, next: usize, limit: Option<std::num::NonZeroUsize>) -> Result<(), Error> {
+    let total = received.checked_add(next).ok_or_else(|| Error::Protocol("receive packet exceeds configured byte limit".into()))?;
+    if limit.is_some_and(|limit| total > limit.get()) {
+        return Err(Error::Protocol("receive packet exceeds configured byte limit".into()));
+    }
+    Ok(())
+}
+#[cfg(test)]
+mod receive_limit_tests {
+    use super::*;
+    #[test]
+    fn checks_exact_boundary_aggregate_overflow_and_legacy_default() {
+        let limit = std::num::NonZeroUsize::new(100);
+        assert!(check_packet_size(50, 50, limit).is_ok());
+        assert!(check_packet_size(50, 51, limit).is_err());
+        assert!(check_packet_size(0, 101, limit).is_err());
+        assert!(check_packet_size(usize::MAX, 1, None).is_err());
+        assert!(check_packet_size(0, 101, None).is_ok());
+    }
+}
